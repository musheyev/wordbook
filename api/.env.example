# Copy to .env and fill in real values. Do NOT commit .env.

# --- AWS ---
# DynamoDB region. AWS credentials come from the standard provider chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or ~/.aws/credentials).
AWS_REGION=us-east-1

# --- Cognito ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret

# --- App URLs ---
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
PORT=4000

# --- Third-party APIs ---
WORDNIK_API_KEY=your-wordnik-api-key
GOOGLE_SEARCH_KEY=your-google-custom-search-api-key
GOOGLE_SEARCH_CX=your-google-custom-search-engine-id
GOOGLE_TRANSLATE_KEY=your-google-translate-api-key
